{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "script.json: 슬라이드별 자막 원문",
  "type": "object",
  "required": ["slides"],
  "additionalProperties": false,
  "properties": {
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slideIndex", "title", "lines"],
        "additionalProperties": false,
        "properties": {
          "slideIndex": { "description": "0부터 시작합니다.", "type": "integer", "minimum": 0 },
          "title": { "type": "string" },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "display", "pauseAfterSeconds"],
              "additionalProperties": false,
              "properties": {
                "id": { "description": "s<슬라이드 두 자리>-l<줄 두 자리>", "type": "string", "pattern": "^s[0-9]{2,3}-l[0-9]{2,3}$" },
                "display": { "type": "string", "minLength": 1 },
                "pauseAfterSeconds": { "type": "number", "minimum": 0 },
                "stageDirection": { "description": "대본의 무대 지시 원문. 애니메이션 시작점을 정할 때 읽습니다.", "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
