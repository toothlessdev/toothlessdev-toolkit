{
  "name": "toothlessdev-toolkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "n8n": "n8n",
    "deploy:n8n-nodes": "node scripts/deploy-n8n-nodes.mjs",
    "register:n8n-plist": "node scripts/register-n8n-plist.macos.mjs",
    "format": "prettier --write packages scripts",
    "format:check": "prettier --check packages scripts --ignore-unknown",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --passWithNoTests --dir packages"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "n8n": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
