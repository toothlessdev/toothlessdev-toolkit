{
  "name": "n8n-slack-socket",
  "version": "0.1.0",
  "private": true,
  "description": "Slack Socket Mode 이벤트로 워크플로를 시작하는 n8n 트리거 노드",
  "scripts": {
    "build": "rm -rf dist && esbuild src/nodes/SlackSocketTrigger/SlackSocketTrigger.node.ts src/credentials/SlackSocketApi.credentials.ts --bundle --platform=node --format=cjs --target=node24 --external:n8n-workflow --outbase=src --outdir=dist --log-level=warning && cp src/nodes/SlackSocketTrigger/slack-logo.svg dist/nodes/SlackSocketTrigger/",
    "typecheck": "tsc -p tsconfig.json"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SlackSocketApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SlackSocketTrigger/SlackSocketTrigger.node.js"
    ]
  },
  "dependencies": {
    "@slack/socket-mode": "catalog:"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "esbuild": "catalog:",
    "n8n-workflow": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  }
}
